# Configuração do Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados
DB_PATH=./db/gramap.db

# JWT (Autenticação)
JWT_SECRET=sua_chave_secreta_super_segura_aqui_change_me
JWT_EXPIRY=7d

# Upload de Arquivos
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000

# Modo Debug
DEBUG=false